# --- AWS Bedrock (required) -------------------------------------------------
# A Bedrock API key works on its own. Standard AWS keys work too, in which case
# use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead of the bearer token.
# Paste the key unquoted - surrounding quotes stop it from being read.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1

# --- Model (optional) -------------------------------------------------------
# Any Bedrock model id you have access to.
# BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5

# --- LangSmith tracing (optional) -------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=langchain-demo
