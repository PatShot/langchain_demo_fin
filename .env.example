# --- Which model server to use ----------------------------------------------
# ollama (default) | llamacpp | bedrock
LLM_PROVIDER=ollama

# --- Ollama (local server) --------------------------------------------------
# Use a model you already have (`ollama list`) that supports tool calling.
OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# --- llama.cpp (local `llama-server`) ---------------------------------------
# Default port is 9931; match whatever --port you started the server with.
# LLAMACPP_BASE_URL=http://localhost:9931/v1
# LLAMACPP_MODEL=local-model
# LLAMACPP_API_KEY=not-needed   # only checked if the server uses --api-key

# --- AWS Bedrock (optional) -------------------------------------------------
# Only needed with LLM_PROVIDER=bedrock. A Bedrock API key works on its own.
# Standard AWS keys work too (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
# Paste the key unquoted - surrounding quotes stop it from being read.
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5

# --- LangSmith tracing (optional) -------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=langchain-demo
